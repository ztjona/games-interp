.claude/
SELF-IMPROVEMENT.md
# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# PyTorch large data files (regeneratable or too large to track)
data/**/*.pt
data/**/*.pth
# models/**/*.pt
models/**/*.pth
*.ckpt
# SAE checkpoints (saes/**/*.pt) are also large and NOT tracked by default.
# Force-add only the key ones -- a runner's final emit_stage step writes the
# exact `git add -f` commands (only the Atlas-shipped checkpoints) to
# stage_<slug>.md, so you never have to guess which. See CLAUDE.md "runners/".
# Metrics (*.jsonl) and registry JSONs ARE tracked (small, useful for cross-device sync).
saes/**/*.pt
# ...but NOT the runtime lock files or hand-made registry backups: a 0-byte lock
# is a process artefact, and a *.bak of a file that is already under version
# control is a second, silently-diverging copy of it (untracked 2026-09-04).
saes/**/*.lock
saes/**/*.bak
# ...nor the registry's write-then-rename staging file. It normally exists for
# microseconds (lib/sae/registry.py writes *.tmp then .replace()s it), but an
# interrupted write leaves one behind, and a half-written registry is the last
# thing that should reach a commit.
saes/**/*.tmp

# Per-runner stage plans (auto-generated to-do lists; regenerated every run)
/stage_*.md

# Logs
logs/
# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/

# Vendored third-party repos checked out for reference (SAE_BoardGameEval, ...).
# Not ours to track, and their test modules break a bare `pytest` run -- see
# pytest.ini norecursedirs.
repositories/
