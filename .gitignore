.claude/
SELF-IMPROVEMENT.md
# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# PyTorch large data files (regeneratable or too large to track)
data/**/*.pt
data/**/*.pth
# models/**/*.pt
models/**/*.pth
*.ckpt
# SAE checkpoints (saes/**/*.pt) are also large and NOT tracked by default.
# Force-add only the key ones -- a runner's final emit_stage step writes the
# exact `git add -f` commands (only the Atlas-shipped checkpoints) to
# stage_<slug>.md, so you never have to guess which. See CLAUDE.md "runners/".
# Metrics (*.jsonl) and registry JSONs ARE tracked (small, useful for cross-device sync).
saes/**/*.pt

# Per-runner stage plans (auto-generated to-do lists; regenerated every run)
/stage_*.md

# Logs
logs/
# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/

# Vendored third-party repos checked out for reference (SAE_BoardGameEval, ...).
# Not ours to track, and their test modules break a bare `pytest` run -- see
# pytest.ini norecursedirs.
repositories/
