SELF-IMPROVEMENT.md
# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# PyTorch large data files (regeneratable or too large to track)
data/**/*.pt
data/**/*.pth
models/**/*.pt
models/**/*.pth
*.ckpt
# SAE checkpoints (saes/**/*.pt) are also large and NOT tracked by default.
# Force-add only the key ones: git add -f saes/quarto/<run_id>.pt
# Metrics (*.jsonl) and registry JSONs ARE tracked (small, useful for cross-device sync).
saes/**/*.pt

# Logs
logs/
